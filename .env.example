# ==============================================================================
# CALENDARIO & RECORDATORIOS PERSONAL - VARIABLES DE ENTORNO
# ==============================================================================

# Zona Horaria (Por defecto: Europe/Madrid)
TZ=Europe/Madrid

# ------------------------------------------------------------------------------
# OPCIÓN 1: NOTIFICACIONES PUSH A IPHONE VÍA NTFY.SH (RECOMENDADO)
# ------------------------------------------------------------------------------
# Elige un topic único y privado (ej: hector_eventos_notif_987x)
# Descarga la app ntfy en tu iPhone y suscríbete a este mismo topic.
NTFY_TOPIC=mi_calendario_privado_hector_2026
NTFY_SERVER_URL=https://ntfy.sh
# Token opcional si usas un servidor ntfy privado con autenticación
NTFY_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# OPCIÓN 2: NOTIFICACIONES VÍA TELEGRAM BOT (OPCIONAL O COMPLEMENTARIO)
# ------------------------------------------------------------------------------
# 1. Crea un bot con @BotFather en Telegram y copia el token
# 2. Obtén tu Chat ID hablando con @userinfobot en Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# CONFIGURACIÓN DEL SISTEMA
# ------------------------------------------------------------------------------
# Frecuencia en minutos para verificar y disparar eventos pendientes
SCHEDULER_INTERVAL_MINUTES=5

# URL pública o local de la aplicación (usada para enlaces en las notificaciones)
APP_URL=http://localhost:8000

# Base de datos SQLite (dentro del contenedor Docker se monta en /app/data)
DATABASE_URL=sqlite:////app/data/calendar.db
